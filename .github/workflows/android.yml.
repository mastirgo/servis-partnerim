name: Servis Partnerim APK

on:
  workflow_dispatch:
  push:
    branches:
      - main
    paths:
      - 'index-test.html'
      - '.github/workflows/android.yml'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Kaynak kodu al
        uses: actions/checkout@v4

      - name: Java kur
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Node.js kur
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Capacitor hazırla
        run: |
          npm init -y
          npm install @capacitor/core@6 @capacitor/cli@6 @capacitor/android@6
          mkdir www
          cp index-test.html www/index.html
          echo '{"appId":"com.mastirgo.servispartnerim","appName":"Servis Partnerim","webDir":"www"}' > capacitor.config.json
          npx cap add android
          npx cap sync android

      - name: APK oluştur
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: APK dosyasını yayınla
        uses: actions/upload-artifact@v4
        with:
          name: Servis-Partnerim-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
